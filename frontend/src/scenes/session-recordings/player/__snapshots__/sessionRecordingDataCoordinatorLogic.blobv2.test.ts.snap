                                                                                                      {
                                                                                                        "id": 19941,
                                                                                                        "rootId": 18508,
                                                                                                        "textContent": "Hey Posthog Team!",
                                                                                                        "type": 3,
                                                                                                      },
                                                                                                    ],
                                                                                                    "id": 19940,
                                                                                                    "rootId": 18508,
                                                                                                    "tagName": "p",
                                                                                                    "type": 2,
                                                                                                  },
                                                                                                  {
                                                                                                    "id": 19942,
                                                                                                    "rootId": 18508,
                                                                                                    "textContent": "
",
                                                                                                    "type": 3,
                                                                                                  },
                                                                                                  {
                                                                                                    "attributes": {},
                                                                                                    "childNodes": [
                                                                                                      {
                                                                                                        "id": 19944,
                                                                                                        "rootId": 18508,
                                                                                                        "textContent": "Let's say I want to get data into the data warehouse, but from a source y'all do not currently support. Take Auth0, for example.",
                                                                                                        "type": 3,
                                                                                                      },
                                                                                                    ],
                                                                                                    "id": 19943,
                                                                                                    "rootId": 18508,
                                                                                                    "tagName": "p",
                                                                                                    "type": 2,
                                                                                                  },
                                                                                                  {
                                                                                                    "id": 19945,
                                                                                                    "rootId": 18508,
                                                                                                    "textContent": "
",
                                                                                                    "type": 3,
                                                                                                  },
                                                                                                  {
                                                                                                    "attributes": {},
                                                                                                    "childNodes": [
                                                                                                      {
                                                                                                        "id": 19947,
                                                                                                        "rootId": 18508,
                                                                                                        "textContent": "What are my options?",
                                                                                                        "type": 3,
                                                                                                      },
                                                                                                    ],
                                                                                                    "id": 19946,
                                                                                                    "rootId": 18508,
                                                                                                    "tagName": "p",
                                                                                                    "type": 2,
                                                                                                  },
                                                                                                  {
                                                                                                    "id": 19948,
                                                                                                    "rootId": 18508,
                                                                                                    "textContent": "
",
                                                                                                    "type": 3,
                                                                                                  },
                                                                                                  {
                                                                                                    "attributes": {},
                                                                                                    "childNodes": [
                                                                                                      {
                                                                                                        "id": 19950,
                                                                                                        "rootId": 18508,
                                                                                                        "textContent": "Do I have to get it into a database (e.g. Postgres, Snowflake, or SQL Server) and then can sync that into the data warehouse?",
