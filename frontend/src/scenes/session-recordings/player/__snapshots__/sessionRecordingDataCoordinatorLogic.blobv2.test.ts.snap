                                                                                                                },
                                                                                                                "childNodes": [
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 20506,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "Hello Renee!",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 20505,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 20507,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 20509,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "Thanks for the feedback! It's important to note that column ordering does ",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                      {
                                                                                                                        "attributes": {},
                                                                                                                        "childNodes": [
                                                                                                                          {
                                                                                                                            "id": 20511,
                                                                                                                            "rootId": 18508,
                                                                                                                            "textContent": "not",
                                                                                                                            "type": 3,
                                                                                                                          },
                                                                                                                        ],
                                                                                                                        "id": 20510,
                                                                                                                        "rootId": 18508,
                                                                                                                        "tagName": "em",
                                                                                                                        "type": 2,
                                                                                                                      },
                                                                                                                      {
                                                                                                                        "id": 20512,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": " impact the way the batch export works, as we match fields one by one by name, regardless of their order.",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 20508,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 20513,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 20515,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "That being said, we see how this can be confusing and frustrating after the data is exported, so we will be deploying a code change to ensure stable ordering in persons batch export columns. Any new persons batch exports will always have the following column order: ",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                      {
                                                                                                                        "attributes": {
                                                                                                                          "class": "break-all inline-block",
                                                                                                                        },
                                                                                                                        "childNodes": [
                                                                                                                          {
                                                                                                                            "id": 20517,
                                                                                                                            "rootId": 18508,
                                                                                                                            "textContent": "team_id",
                                                                                                                            "type": 3,
                                                                                                                          },
                                                                                                                        ],
                                                                                                                        "id": 20516,
                                                                                                                        "rootId": 18508,
                                                                                                                        "tagName": "code",
                                                                                                                        "type": 2,
                                                                                                                      },
                                                                                                                      {
