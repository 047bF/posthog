                                                                                                    "type": 2,
                                                                                                  },
                                                                                                  {
                                                                                                    "attributes": {
                                                                                                      "class": "border-l-0 ml-[33px] pl-0 pb-1",
                                                                                                    },
                                                                                                    "childNodes": [
                                                                                                      {
                                                                                                        "attributes": {},
