                                                                                                  },
                                                                                                  {
                                                                                                    "attributes": {},
                                                                                                    "childNodes": [
                                                                                                      {
                                                                                                        "id": 20477,
                                                                                                        "rootId": 18508,
                                                                                                        "textContent": "Event batch export does not have this issue.
