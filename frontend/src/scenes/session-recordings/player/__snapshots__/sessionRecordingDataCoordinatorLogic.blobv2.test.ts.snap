                                                                                                    ],
                                                                                                    "id": 19747,
                                                                                                    "rootId": 18508,
                                                                                                    "tagName": "div",
                                                                                                    "type": 2,
                                                                                                  },
                                                                                                  {
                                                                                                    "attributes": {
                                                                                                      "class": "border-l-0 ml-[33px] pl-0 pb-1",
                                                                                                    },
                                                                                                    "childNodes": [
                                                                                                      {
                                                                                                        "attributes": {},
                                                                                                        "childNodes": [
                                                                                                          {
                                                                                                            "attributes": {
                                                                                                              "class": "",
                                                                                                            },
                                                                                                            "childNodes": [
                                                                                                              {
                                                                                                                "attributes": {
                                                                                                                  "class": "flex-1 !text-sm overflow-hidden text-ellipsis !pb-0 mr-1 text-primary/75 dark:text-primary-dark/75 font-normal [&_p:last-child]:mb-0 question-content community-post-markdown",
                                                                                                                },
                                                                                                                "childNodes": [
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 19772,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "Hello Mathew,",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 19771,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 19773,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 19775,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "Thank you for bringing up this issue to us!",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 19774,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 19776,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 19778,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "We have looked into the issue and have identified the root cause: Multiple batch exports of mutable models (Persons in this case) in different projects exporting data to the same destination table can conflict with each other, thus causing errors like the ones you are seeing. Since this conflict relies heavily on the timing of when each batch export runs, and this timing varies each day, the error appears sporadically.",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 19777,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 19779,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 19781,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "We do want to support multiple batch exports from different projects targeting the same table, so we are making some changes to avoid conflicts between these batch exports (see GitHub PR ",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                      {
                                                                                                                        "attributes": {
                                                                                                                          "href": "https://github.com/PostHog/posthog/pull/28321",
                                                                                                                          "rel": "nofollow",
                                                                                                                        },
                                                                                                                        "childNodes": [
                                                                                                                          {
                                                                                                                            "id": 19783,
                                                                                                                            "rootId": 18508,
                                                                                                                            "textContent": "here",
                                                                                                                            "type": 3,
                                                                                                                          },
                                                                                                                        ],
                                                                                                                        "id": 19782,
                                                                                                                        "rootId": 18508,
                                                                                                                        "tagName": "a",
                                                                                                                        "type": 2,
                                                                                                                      },
                                                                                                                      {
                                                                                                                        "id": 19784,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": ").",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 19780,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 19785,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 19787,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "I expect the changes to be deployed to PostHog later today or early tomorrow. You should not see anymore errors after they are deployed.",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 19786,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                ],
                                                                                                                "id": 19770,
                                                                                                                "rootId": 18508,
                                                                                                                "tagName": "div",
                                                                                                                "type": 2,
                                                                                                              },
                                                                                                            ],
