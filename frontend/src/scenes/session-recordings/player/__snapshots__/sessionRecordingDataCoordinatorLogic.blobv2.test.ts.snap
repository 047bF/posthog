                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": ".",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 20514,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 20534,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 20536,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "Unfortunately, this will not change any existing tables, as it only ensures ordering is stable moving forward. Making this change in our user's destinations would require a lot more work to mutate a table in each of the different destinations, which is not an operation we currently do. Naturally, a database admin can always move the data to a new table, and as long as the name is preserved, the batch export should continue to work.",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 20535,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 20537,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 20539,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "Once again, thank you for bringing this up!",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 20538,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
