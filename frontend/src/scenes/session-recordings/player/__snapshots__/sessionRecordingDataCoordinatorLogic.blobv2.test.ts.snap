                                                                                                                            "id": 20520,
                                                                                                                            "rootId": 18508,
                                                                                                                            "textContent": "distinct_id",
                                                                                                                            "type": 3,
                                                                                                                          },
                                                                                                                        ],
                                                                                                                        "id": 20519,
