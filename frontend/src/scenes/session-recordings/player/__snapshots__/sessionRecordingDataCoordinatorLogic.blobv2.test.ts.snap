                                                                                                                    ],
                                                                                                                    "id": 20140,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 20143,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 20145,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "This approach allows you to bring in data from any custom source, not just Auth0, as long as you can export it to a compatible format and upload it to a supported cloud storage service.",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 20144,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
                                                                                                                    "type": 2,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "id": 20146,
                                                                                                                    "rootId": 18508,
                                                                                                                    "textContent": "
",
                                                                                                                    "type": 3,
                                                                                                                  },
                                                                                                                  {
                                                                                                                    "attributes": {},
                                                                                                                    "childNodes": [
                                                                                                                      {
                                                                                                                        "id": 20148,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": "As for your question about databases, while PostHog does support some database integrations like Postgres, Snowflake, and Azure SQL Server",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                      {
                                                                                                                        "attributes": {
                                                                                                                          "href": "https://posthog.com/docs/data-warehouse/setup",
                                                                                                                          "rel": "nofollow",
                                                                                                                        },
                                                                                                                        "childNodes": [
                                                                                                                          {
                                                                                                                            "id": 20150,
                                                                                                                            "rootId": 18508,
                                                                                                                            "textContent": "(4)",
                                                                                                                            "type": 3,
                                                                                                                          },
                                                                                                                        ],
                                                                                                                        "id": 20149,
                                                                                                                        "rootId": 18508,
                                                                                                                        "tagName": "a",
                                                                                                                        "type": 2,
                                                                                                                      },
                                                                                                                      {
                                                                                                                        "id": 20151,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": ", using cloud storage for custom data sources often provides more flexibility and can be more cost-effective, as you mentioned.",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                    ],
                                                                                                                    "id": 20147,
                                                                                                                    "rootId": 18508,
                                                                                                                    "tagName": "p",
