                                                                                                                            "textContent": "person_distinct_id_version",
                                                                                                                            "type": 3,
                                                                                                                          },
                                                                                                                        ],
                                                                                                                        "id": 20528,
                                                                                                                        "rootId": 18508,
                                                                                                                        "tagName": "code",
                                                                                                                        "type": 2,
                                                                                                                      },
                                                                                                                      {
                                                                                                                        "id": 20530,
                                                                                                                        "rootId": 18508,
                                                                                                                        "textContent": ", and ",
                                                                                                                        "type": 3,
                                                                                                                      },
                                                                                                                      {
                                                                                                                        "attributes": {
                                                                                                                          "class": "break-all inline-block",
                                                                                                                        },
                                                                                                                        "childNodes": [
                                                                                                                          {
